SEC_API_KEY=
SEC_API_BASE_URL=https://api.sec.or.th
DATA_DIR=data
SEC_CACHE_DIR=data/sec

# Comma-separated list of origins the frontend is served from, e.g.
# https://myapp.onrender.com,https://myapp.example.com
# Leave blank / unset to allow any origin (default) -- safe here since this
# API has no cookies/sessions, and it means it works out of the box for a
# deployer who doesn't set this.
ALLOWED_ORIGINS=*
